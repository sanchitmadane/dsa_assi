package class_work;

public class BTNodeQueue {
	
	private BTNode arr[];
	private int front, rear;
	
	public BTNodeQueue(int size)
	{
		arr = new BTNode[size];
		front = rear = -1;
	}
	
	public boolean isEmpty()
	{
		return front == -1;
	}
	
	public boolean isFull()
	{
		return rear == arr.length-1;
	}
	
	public void insert(BTNode node)
	{
		if(isFull())
		{
			System.out.println("Queue Full");
			return;
		}
		
		if(front == -1)
		{
			front = 0;
		}
		
		rear ++;
		
		arr[rear] = node;
	}
	
	public BTNode del()
	{
		if(isEmpty())
		{
			return null;
		}
		
		BTNode temp = arr[front];
		
		if(front == rear)
		{
			front = rear = -1;
		}
		else
		{
			front++;
		}
		
		return temp;
	}

}
