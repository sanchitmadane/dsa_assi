package class_work;

public class BinaryTree {

	private BTNode root;
	
	public BinaryTree()
	{
		root = null;
	}
	
	public void setRoot(BTNode r)
	{
		root = r;
	}
	
	public BTNode getRoot()
	{
		return root;
	}
	
	public BTNode createNode(int d)
	{
		return new BTNode(d);
	}

	public void insert_levelwise(int d)
	{
		BTNode new_node = new BTNode(d);
		
		if(root == null)
		{
			root = new_node;
			return;
		}
		
		BTNodeQueue q = new BTNodeQueue(25); //
		BTNode iter = root;
		q.insert(iter);
		while(!q.isEmpty())
		{
			iter = q.del();
			if(iter.getLeft() == null)
			{
				iter.setLeft(new_node);
				return;
			}
			else
			{
				q.insert(iter.getLeft());
			}
			
			if(iter.getRight()== null)
			{
				iter.setRight(new_node);
				return;
			}
			else
			{
				q.insert(iter.getRight());
			}
		}
			
	}
	
	public void insert_display()
	{
		if(root == null)
		{
			System.out.println("Empty..");
			return;
		}
		
		BTNode iter = root;
		BTNodeQueue q = new BTNodeQueue(25);
		q.insert(iter);
		
		while(!q.isEmpty())
		{
			iter = q.del();
			System.out.print(" "+iter.getData());
			
			if(iter.getLeft() != null)
			{
				q.insert(iter.getLeft());
			}
			if(iter.getRight() != null)
			{
				q.insert(iter.getRight());
			}
		}
	}	
}



